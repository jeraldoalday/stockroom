// StockRoom domain model — see docs/PRD.md section 5.
// Every tenant-scoped table carries organizationId and is never queried
// without it (enforced in src/middleware/tenant.ts, not just here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum MovementType {
  RECEIVE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  FULFILLED
  CANCELLED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  locations       Location[]
  categories      Category[]
  suppliers       Supplier[]
  customers       Customer[]
  products        Product[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  salesOrders     SalesOrder[]

  @@map("organizations")
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  passwordHash   String
  name           String
  role           UserRole     @default(STAFF)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stockMovements      StockMovement[]
  passwordResetTokens PasswordResetToken[]

  @@unique([email])
  @@index([organizationId])
  @@map("users")
}

// Forgot-password flow (§13 v1 sign-off deferred this pending an email
// provider). No provider is configured anywhere in this stack yet, so
// lib/email.ts ships a console-logging sender for local dev/demo — see the
// comment there for what a real provider needs to replace. Only the
// tokenHash is stored, never the raw token, so a DB read can't be turned
// into a usable reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  address        String?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventoryItems InventoryItem[]
  stockMovements StockMovement[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("locations")
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("categories")
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
  @@map("suppliers")
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  salesOrders SalesOrder[]

  @@index([organizationId])
  @@map("customers")
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id])
  sku            String
  name           String
  description    String?
  costCents      Int          @default(0)
  priceCents     Int          @default(0)
  reorderPoint   Int          @default(0)
  reorderQty     Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]
  purchaseOrderLines  PurchaseOrderLine[]
  salesOrderLines     SalesOrderLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("products")
}

// Derived/cached quantity on hand per product per location.
// Source of truth is StockMovement; this table is updated transactionally
// alongside every movement insert so reads stay O(1).
model InventoryItem {
  id             String       @id @default(cuid())
  organizationId String
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id])
  quantity       Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([productId, locationId])
  @@index([organizationId])
  @@index([organizationId, quantity])
  @@map("inventory_items")
}

model StockMovement {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  locationId     String
  location       Location      @relation(fields: [locationId], references: [id])
  type           MovementType
  quantity       Int
  reason         String?
  actorId        String
  actor          User          @relation(fields: [actorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  salesOrderId    String?
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([organizationId, productId, locationId])
  @@index([organizationId, createdAt])
  @@map("stock_movements")
}

model PurchaseOrder {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  supplierId     String
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  status         PurchaseOrderStatus  @default(DRAFT)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  lines          PurchaseOrderLine[]
  stockMovements StockMovement[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantityOrdered Int
  quantityReceived Int          @default(0)
  unitCostCents   Int

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model SalesOrder {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id])
  locationId     String
  status         SalesOrderStatus  @default(DRAFT)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lines          SalesOrderLine[]
  stockMovements StockMovement[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id             String     @id @default(cuid())
  salesOrderId   String
  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id])
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int

  @@index([salesOrderId])
  @@map("sales_order_lines")
}
