# No "?schema=..." suffix here (unlike backend/.env.example): that query
# param is a Prisma-only convention and psycopg2 rejects it as an unknown
# connection option.
DATABASE_URL="postgresql://stockroom:stockroom@localhost:5432/stockroom"
CORS_ORIGIN="http://localhost:5173"
PORT=8000
INTERNAL_API_KEY="dev-internal-key"
