// StockRoom domain model — see docs/PRD.md section 5.
// Every tenant-scoped table carries organizationId and is never queried
// without it (enforced in src/middleware/tenant.ts, not just here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum MovementType {
  RECEIVE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  FULFILLED
  CANCELLED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  locations      Location[]
  categories     Category[]
  suppliers      Supplier[]
  customers      Customer[]
  products       Product[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]

  @@map("organizations")
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  passwordHash   String
  name           String
  role           UserRole     @default(STAFF)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stockMovements      StockMovement[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]

  @@unique([email])
  @@index([organizationId])
  @@map("users")
}

// Forgot-password flow (§13 v1 sign-off deferred this pending an email
// provider). No provider is configured anywhere in this stack yet, so
// lib/email.ts ships a console-logging sender for local dev/demo — see the
// comment there for what a real provider needs to replace. Only the
// tokenHash is stored, never the raw token, so a DB read can't be turned
// into a usable reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Refresh tokens are recorded server-side so a session can actually be
// ended. Before this, signing out cleared the browser and nothing else: the
// refresh token stayed valid for its full 7 days, and changing or resetting
// a password did not lock out whoever else was holding one — which made
// "reset your password" useless as a response to a compromised account.
//
// Only the hash is stored, never the token, so a database read can't be
// replayed as a session (same rule as PasswordResetToken).
//
// `familyId` groups every token descended from one login. Rotation issues a
// new token and revokes the old one, so a token presented twice means the
// holder is replaying one that was already exchanged — either a stolen copy
// or the legitimate client racing itself. There is no way to tell which, so
// the whole family is revoked and everyone re-authenticates. That is the
// standard refresh-token-reuse response (OAuth 2.0 BCP section 4.14.2).
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  // Set when this token is rotated, so a replay can be traced to the token
  // that superseded it when reading the table by hand.
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  address        String?
  isDefault      Boolean      @default(false)
  // Archiving, for the same reason Supplier and Customer have this: every
  // movement, sales order and inventory row points at a location, so a
  // location that has ever been used cannot be deleted without either
  // corrupting that history or being refused. A shop that closes a stockroom
  // could previously only leave it in every picker forever.
  //
  // Unlike a supplier, an archived location is also refused for new stock:
  // it is a place goods physically are, and stock recorded into somewhere
  // hidden from every picker is stock nobody can find again.
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  salesOrders    SalesOrder[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("locations")
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  // Archiving, same reason as Supplier/Customer/Location: a category on any
  // product could previously only be hard-deleted, which silently cleared
  // `Product.categoryId` (the FK is ON DELETE SET NULL) with no way to see
  // what a product used to be filed under or bring the name back.
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("categories")
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  // Archiving rather than deleting, for the same reason Product has this:
  // the record is referenced by order history, so removing it would either
  // corrupt that history or be refused outright. Before this, a supplier
  // with any orders simply could not be removed from the list at all.
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
  @@map("suppliers")
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  // Archiving rather than deleting, for the same reason Product has this:
  // the record is referenced by order history, so removing it would either
  // corrupt that history or be refused outright. Before this, a customer
  // with any orders simply could not be removed from the list at all.
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  salesOrders SalesOrder[]

  @@index([organizationId])
  @@map("customers")
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id])
  sku            String
  name           String
  description    String?
  costCents      Int          @default(0)
  priceCents     Int          @default(0)
  reorderPoint   Int          @default(0)
  reorderQty     Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventoryItems     InventoryItem[]
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  salesOrderLines    SalesOrderLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("products")
}

// Derived/cached quantity on hand per product per location.
// Source of truth is StockMovement; this table is updated transactionally
// alongside every movement insert so reads stay O(1).
model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  locationId     String
  location       Location @relation(fields: [locationId], references: [id])
  quantity       Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([organizationId])
  @@index([organizationId, quantity])
  @@map("inventory_items")
}

model StockMovement {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  locationId      String
  location        Location       @relation(fields: [locationId], references: [id])
  type            MovementType
  quantity        Int
  // Unit price for a SALE, in cents. Revenue used to be recoverable only by
  // joining back to a sales order line, so a SALE recorded straight through
  // POST /stock-movements — a counter sale, the common case for a shop —
  // contributed units to the trend report but zero revenue, silently
  // understating takings. Nullable because it is meaningless on a receipt,
  // transfer or adjustment, and because movements recorded before this
  // column existed genuinely have no price to record.
  unitPriceCents  Int?
  reason          String?
  actorId         String
  actor           User           @relation(fields: [actorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  salesOrderId    String?
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([organizationId, productId, locationId])
  @@index([organizationId, createdAt])
  @@map("stock_movements")
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  lines          PurchaseOrderLine[]
  stockMovements StockMovement[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCostCents    Int

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model SalesOrder {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  locationId     String
  // Declared as a relation so the database enforces it. It was a bare
  // column until now, which meant nothing but application code stopped a
  // location being deleted out from under the orders that shipped from it —
  // and the delete route only grew that check once the gap was noticed.
  // The route keeps its check for the sake of a clear error message; this
  // is the backstop for every path that doesn't go through it.
  location       Location         @relation(fields: [locationId], references: [id])
  status         SalesOrderStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  lines          SalesOrderLine[]
  stockMovements StockMovement[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([locationId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id             String     @id @default(cuid())
  salesOrderId   String
  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id])
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int

  @@index([salesOrderId])
  @@map("sales_order_lines")
}
