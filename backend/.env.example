DATABASE_URL="postgresql://stockroom:stockroom@localhost:5432/stockroom?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# How often the API sweeps expired refresh/reset token rows, in ms.
TOKEN_PRUNE_INTERVAL_MS=3600000
PYTHON_SERVICE_URL="http://localhost:8000"
PYTHON_SERVICE_INTERNAL_KEY="dev-internal-key"
# Optional. Unset (the default), forgot-password/invite emails are logged to
# the console instead of sent. Set SMTP_HOST to send for real through any
# provider that speaks SMTP (SendGrid, Postmark, SES, Mailgun, ...).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="apikey"
# SMTP_PASS="change-me"
# SMTP_FROM="StockRoom <no-reply@yourdomain.com>"
