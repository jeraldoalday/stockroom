# No "?schema=..." suffix here (unlike backend/.env.example): that query
# param is a Prisma-only convention and psycopg2 rejects it as an unknown
# connection option.
#
# Connects as stockroom_readonly (SELECT-only grants — PRD §8), not the
# stockroom role backend/ writes with. See db/init/01-create-readonly-role.sql
# for how that role gets created in local dev; docs/DEPLOYMENT.md for prod.
DATABASE_URL="postgresql://stockroom_readonly:stockroom_readonly@localhost:5432/stockroom"
CORS_ORIGIN="http://localhost:5173"
PORT=8000
INTERNAL_API_KEY="dev-internal-key"
